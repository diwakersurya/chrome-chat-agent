{
  "name": "chrome-chat-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:web": "vite --config vite.web.config.ts",
    "dev:ext": "vite --config vite.ext.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:ext": "vite build --config vite.ext.config.ts",
    "build": "bun run build:web && bun run build:ext",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/ai": "0.63.0",
    "@tanstack/ai-client": "0.36.0",
    "@tanstack/ai-react": "0.29.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/chrome": "0.3.4",
    "@types/dom-chromium-ai": "0.0.17",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
